{
  "broker": {
    "type": "rabbitmq",
    "username": "username",
    "password": "password",
    "port": 5672
  },
  "bots": {
    "bot-type-name": {
      "image": "container-image",
      "replicas": 2,
      "mount": [
        {
          "source": "path/to/host/file.extension",
          "target": "path/to/container/file.extension"
        },
        {
          "source": "path/to/host/directory",
          "target": "path/to/container/directory",
          "createHostPath": true
        }
      ],
      "publish": {
        "key": "sample_actions",
        "defaultOrder": "execute_something"
      },
      "subscribe": [
        {
          "key": "subscribe_key_1",
          "strategy": "distributed"
        },
        {
          "key": "subscribe_key_2",
          "strategy": "broadcast"
        }
      ],
      "lifecycle": {
        "type": "proactive",
        "initialDelay": 60,
        "period": 60
      },
      "environment": [
        "KEY1=VALUE2",
        "KEY2=VALUE2"
      ]
    },
    "other-bot-type": {
      "image": "other-container-image",
      "replicas": 2,
      "mount": [
        {
          "source": "path/to/host/file.extension",
          "target": "path/to/container/file.extension"
        }
      ],
      "ports": [
        "8000:8000"
      ],
      "subscribe": [
        {
          "key": "subscribe_key_1",
          "strategy": "distributed"
        },
        {
          "key": "subscribe_key_2",
          "strategy": "broadcast"
        }
      ],
      "environment": [
        "KEY1=VALUE2",
        "KEY2=VALUE2"
      ],
      "instances": {
        "other-bot-type-custom-instance-1": {
          "environment": [
            "KEY3=VALUE3"
          ]
        },
        "other-bot-type-custom-instance-2": {
          "environment": [
            "KEY2=OVERRIDDEN_VALUE_FROM_TYPE"
          ]
        }
      }
    },
    "database-type": {
      "image": "my-database-image",
      "replicas": 1,
      "mount": [
        {
          "source": "path/to/host/directory",
          "target": "path/to/container/directory",
          "createHostPath": true
        }
      ],
      "lifecycle": {
        "type": "unmanaged"
      },
      "environment": [
        "KEY=VALUE"
      ]
    }
  }
}